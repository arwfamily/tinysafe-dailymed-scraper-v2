               <id root="3c91d86e-5a41-4b49-94b9-b8033f851934"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Sunscreen</paragraph>
               </text>
               <effectiveTime value="20200225"/>
            </section>
         </component>
         <component>
            <section>
               <id root="742f2a54-80e3-4b41-8e9b-7f17066f1e6d"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <list styleCode="disc" listType="unordered">
                     <item>Helps prevent sunburn</item>
                     <item>If used as directed with other sun protection measures (see <content styleCode="bold">
                           <linkHtml href="#Directions">Directions</linkHtml>
                        </content>), decreases the risk of skin cancer &amp; early signs of aging caused by the sun.</item>
                  </list>
               </text>
               <effectiveTime value="20200225"/>
            </section>
         </component>
         <component>
            <section>
               <id root="afb22ac3-a32f-49a5-8b73-2d8f85165f25"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <list styleCode="disc" listType="unordered">
                     <item>
                        <content styleCode="bold">For external use only</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20200225"/>
               <component>
                  <section>
                     <id root="4e87451b-6422-4626-b925-834cff164854"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <text>
                        <list styleCode="disc" listType="unordered">
                           <item>
                              <content styleCode="bold">Do not use</content> on damaged or broken skin.</item>
                        </list>
                     </text>
                     <effectiveTime value="20200225"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="608d014d-9d61-4940-83b6-a2418cf7faad"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <text>
                        <list styleCode="disc" listType="unordered">
                           <item>Stop use and ask a doctor if rash occurs.</item>
                        </list>
                     </text>
                     <effectiveTime value="20200225"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="132e06e9-7382-40ba-8ac3-fb5a1a7a7deb"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <text>
                        <list styleCode="disc" listType="unordered">
                           <item>
                              <content styleCode="bold">When using this product</content> keep out of eyes. Rinse with water to remove.</item>
                        </list>
                     </text>
                     <effectiveTime value="20200225"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="a9e2cd1a-663d-42c7-b25d-d4b81852274b"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <text>
                        <list styleCode="disc" listType="unordered">
                           <item>
                              <content styleCode="bold">Keep out of reach of children.</content> If swallowed, get medical help or contact a poison control center right away.</item>
                        </list>
                     </text>
                     <effectiveTime value="20200225"/>
                  </section>
               </component>
            </section>
