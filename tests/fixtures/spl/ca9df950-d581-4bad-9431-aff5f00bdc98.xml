               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Sunscreen, Sunscreen, Sunscreen, Sunscreen, Sunscreen, Sunscreen, </paragraph>
               </text>
               <effectiveTime value="20130429"/>
            </section>
