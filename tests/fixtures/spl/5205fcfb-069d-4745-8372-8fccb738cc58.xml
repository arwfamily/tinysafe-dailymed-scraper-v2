            <section ID="L72d34d85-24d2-43da-8561-b6e612196552">
               <id root="6cd40e80-621b-4e9d-a50c-9c771180b6aa"/>
               <code code="43685-7" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS AND PRECAUTIONS SECTION"/>
               <title/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Active ingredients                                                               Purpose</content>
                     <br/>Avobenzone 3%...................................................................Sunscreen<br/>Homosalate 15%.................................................................Sunscreen<br/>Octisalate 5%......................................................................Sunscreen<br/>Octocrylene 10%.................................................................Sunscreen</paragraph>
               </text>
               <effectiveTime value="20180502"/>
            </section>
