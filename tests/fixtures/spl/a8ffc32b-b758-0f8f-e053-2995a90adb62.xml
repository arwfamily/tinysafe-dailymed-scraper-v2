            <section ID="id_link_494a81f9-6863-1b83-e054-00144ff88e88">
               <id root="a8ffcab4-1208-1d29-e053-2a95a90a14b5"/>
               <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
               <title>When Using this Product</title>
               <text>
                  <paragraph>Keep out of eyes. Rinse well with water to remove.</paragraph>
               </text>
               <effectiveTime value="20200217"/>
            </section>
         </component>
         <component>
            <section ID="id_link_44d12888-4578-37b4-e054-00144ff88e88">
               <id root="a8ffcab4-1209-1d29-e053-2a95a90a14b5"/>
               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <title>Keep out of reach of children</title>
               <text>
                  <paragraph>Keep out of reach of children.</paragraph>
                  <paragraph>If swallowed, get medical help or contact a Poison Control Center right away.</paragraph>
               </text>
               <effectiveTime value="20200217"/>
            </section>
         </component>
         <component>
            <section ID="id_link_494af611-8cb7-2aa6-e054-00144ff8d46c">
               <id root="a8ffcab4-120a-1d29-e053-2a95a90a14b5"/>
               <code code="60562-6" codeSystem="2.16.840.1.113883.6.1" displayName="ROUTE, METHOD AND FREQUENCY OF ADMINISTRATION"/>
               <title>Directions</title>
               <text>
                  <paragraph>Apply liberally 15 minutes before sun exposure</paragraph>
                  <paragraph>Use a water resistant sunscreen if swimming or sweating</paragraph>
                  <paragraph>Reapply at least every 2 hours
  
       
 
  
       
 
  
       
 
  <br/>
Children under 6 months of age: 
  
       
 
  
       
 
  
       
 
  <content styleCode="bold">Ask a doctor</content>
                  </paragraph>
               </text>
               <effectiveTime value="20200217"/>
            </section>
