               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <paragraph>■ protect this product from excessive heat and direct sun</paragraph>
                  <paragraph>■ may stain or damage some fabrics or surfaces</paragraph>
               </text>
               <effectiveTime value="20231108"/>
            </section>
         </component>
