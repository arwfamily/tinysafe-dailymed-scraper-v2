               <code code="43685-7" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS AND PRECAUTIONS SECTION"/>
               <title>Other Information</title>
               <text>
                  <paragraph>protect this product from excessive heat and direct sun</paragraph>
                  <br/>
               </text>
               <effectiveTime value="20130709"/>
            </section>
         </component>
         <component>
            <section>
               <id root="09b674eb-a670-4a52-97d6-91826743d1ee"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <list listType="unordered" ID="if7fc3b67-ea8f-4149-8720-cbddacd63895">
                     <item>helps prevent sunburn</item>
                     <item>if used as directed with other sun protection measures ( see directions), decrease the risk of skin cancer and early skin aging caused by the sun.<br/>
                     </item>
                  </list>
                  <br/>
               </text>
               <effectiveTime value="20130709"/>
            </section>
         </component>
