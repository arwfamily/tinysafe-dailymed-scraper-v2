               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only<br/>
                     </content>Flammable: Do not Puncture or incinerate, Contents under pressure.</paragraph>
                  <paragraph>Do not store at temperatures above 120 F. Do not use in the presence of a flame or spark. Keep away from sources of Ignition-No smoking.</paragraph>
                  <paragraph/>
                  <br/>
               </text>
               <effectiveTime value="20130709"/>
               <component>
                  <section>
                     <id root="e5c08f6e-7f06-4b2e-9885-4ee2d7170ebe"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>Stop use and ask a doctor</title>
                     <text>
                        <paragraph>if rash occurs</paragraph>
                        <paragraph/>
                        <br/>
                     </text>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="9b67bb6b-01f9-4433-ba63-1d7e8fbcd43e"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>When using this product</title>
                     <text>
                        <list listType="unordered" ID="i5a07dc01-d7f7-438b-8170-502683cb0bac">
                           <item>Keep away from face to avoid breaching it <br/>
                           </item>
                           <item>keep out of eyes</item>
                           <item>Rinse with water to remove.</item>
                        </list>
                        <paragraph/>
                        <paragraph/>
                        <br/>
                     </text>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="2e0e977c-bbe9-4d56-a7b6-209b372715a0"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>keep out of reach of children</title>
                     <text>
                        <paragraph>if product is swallowed, get medical help or contact a Poison Control Center right away.</paragraph>
                        <list listType="unordered" ID="i34a553cc-e64c-4b21-8976-353a0d7b3e70">
                           <item>May stain some fabrics.</item>
                           <item>Intentional misuse by deliberately concentrating and inhaling the contents can be harmful or fatal.<br/>
                           </item>
                        </list>
                        <br/>
                     </text>
                  </section>
               </component>
            </section>
