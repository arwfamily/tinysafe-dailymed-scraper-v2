            <section ID="id_link_47020844-f5c7-5609-e054-00144ff8d46c">
               <id root="52e4c7cd-697c-d8e6-e063-6394a90ac39f"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>
                  <content styleCode="bold">Active Ingredients </content>
               </title>
               <text>
                  <paragraph>Avobenzone 3.0%, Homosalate 10.0%, Octisalate 5.0%,Octocrylene 10.0%, Oxybenzone 6.0%</paragraph>
               </text>
               <effectiveTime value="20261001"/>
            </section>
